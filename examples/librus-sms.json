    "id": "a1f0c0de0000000b",
    "type": "function",
    "name": "Rodzic 1",
    "func": "// SMS do jednej osoby – tekst przychodzi w msg.payload (z „SMS ocena” albo „SMS uwaga”).\nconst NUMER = '48600000001';                              // numer odbiorcy: 48 + 9 cyfr\nconst BRAMKA = 'https://bramka-sms.example/send/';    // adres Twojej bramki SMS\nconst tekst = typeof msg.payload === 'string' ? msg.payload : '';\nif (!tekst) return null;   // nigdy nie wysyłaj pustego SMS-a\nmsg.method = 'GET';\nmsg.url = BRAMKA + NUMER + '?text=' + encodeURIComponent(tekst);\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
